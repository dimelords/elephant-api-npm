{
  "name": "@ttab/elephant-api",
  "private": false,
  "license": "MIT",
  "version": "0.24.3",
  "type": "module",
  "exports": {
    "./repository": {
      "import": {
        "types": "./dist/repository/index.d.mts",
        "default": "./dist/repository/index.mjs"
      },
      "require": {
        "types": "./dist/repository/index.d.cts",
        "default": "./dist/repository/index.cjs"
      }
    },
    "./repositorysocket": {
      "import": {
        "types": "./dist/repositorysocket/index.d.mts",
        "default": "./dist/repositorysocket/index.mjs"
      },
      "require": {
        "types": "./dist/repositorysocket/index.d.cts",
        "default": "./dist/repositorysocket/index.cjs"
      }
    },
    "./newsdoc": {
      "import": {
        "types": "./dist/newsdoc/newsdoc.d.mts",
        "default": "./dist/newsdoc/newsdoc.mjs"
      },
      "require": {
        "types": "./dist/newsdoc/newsdoc.d.cts",
        "default": "./dist/newsdoc/newsdoc.cjs"
      }
    },
    "./index": {
      "import": {
        "types": "./dist/index/index.d.mts",
        "default": "./dist/index/index.mjs"
      },
      "require": {
        "types": "./dist/index/index.d.cts",
        "default": "./dist/index/index.cjs"
      }
    },
    "./spell": {
      "import": {
        "types": "./dist/spell/index.d.mts",
        "default": "./dist/spell/index.mjs"
      },
      "require": {
        "types": "./dist/spell/index.d.cts",
        "default": "./dist/spell/index.cjs"
      }
    },
    "./user": {
      "import": {
        "types": "./dist/user/index.d.mts",
        "default": "./dist/user/index.mjs"
      },
      "require": {
        "types": "./dist/user/index.d.cts",
        "default": "./dist/user/index.cjs"
      }
    },
    "./replicant": {
      "import": {
        "types": "./dist/replicant/index.d.mts",
        "default": "./dist/replicant/index.mjs"
      },
      "require": {
        "types": "./dist/replicant/index.d.cts",
        "default": "./dist/replicant/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ttab/elephant-api-npm"
  },
  "scripts": {
    "test": "echo \"no tests\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "build": "pnpm run typecheck && tsdown",
    "update": "bash scripts/update.sh",
    "prepublishOnly": "pnpm run build"
  },
  "author": "",
  "description": "",
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  }
}
